# =============================================
# AI 电脑控制 - 配置文件
# =============================================

# ----- 应用信息 -----
APP_NAME="AI Assistant"
APP_VERSION="1.0.0"

# ----- 服务器设置 -----
HOST="0.0.0.0"
PORT=8000
WEBSOCKET_PORT=15000
RCON_PORT=15001
API_PORT=15002
SCREEN_MONITOR_PORT=15004
VIDEO_EDITOR_PORT=15010

# ----- 运行模式 -----
DEBUG=false
NOUI=false
NOWEB=false
NOEDITOR=false
NOMONITOR=false

# ----- 桌面监控设置 -----
SCREEN_MONITOR_QUALITY=50
SCREEN_MONITOR_FPS=30
SCREEN_MONITOR_BITRATE=2500000

# ----- 日志设置 -----
LOG_LEVEL="INFO"
LOG_DIR="logs"
LOG_ROTATION="1 day"
LOG_RETENTION="7 days"

# ----- 性能设置 -----
ENABLE_PROFILING=false
ENABLE_SYSTRAY=true
ENABLE_AUTO_START=false

# ----- 权限设置 -----
PERMISSION_LEVEL="normal"

# ----- 数据库设置 -----
DB_DIR="userspick"
DB_TYPE="sqlite"

# ----- Celery 设置 -----
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# ----- AI 模型设置 -----
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL=""
MODEL_NAME="z-ai/glm4.7"
TEMPERATURE=1.0
TOP_P=1.0
MAX_TOKENS=16384
ENABLE_THINKING=true
CLEAR_THINKING=false

# ----- AI 速率限制 -----
MAX_CALLS_PER_MINUTE=40
MAX_ITERATIONS=10
ITERATION_DELAY=1.0

# ----- 历史记录设置 -----
MAX_HISTORY=100
AUTO_SAVE=true
AUTO_SAVE_INTERVAL=300

# ----- 界面设置 -----
THEME="dark"
THEME_COLOR="blue"
LANGUAGE="zh_CN"
TIMEZONE="Asia/Shanghai"

# ----- 代理设置 -----
PROXY_ENABLED=false
PROXY_URL=""

# ----- SSL/TLS 设置 -----
CERT_ENABLED=false
CERT_PATH=""
KEY_PATH=""

# ----- Nvidia API 设置 -----
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
